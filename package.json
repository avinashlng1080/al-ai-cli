{
  "name": "zen-cli",
  "version": "0.1.0",
  "description": "A Claude Code-style agentic CLI for Chinese AI providers",
  "type": "module",
  "main": "src/cli.tsx",
  "bin": {
    "zen": "src/cli.tsx"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "bun build src/cli.tsx --compile --outfile zen",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "diff": "^7.0.0",
    "ink": "^4.4.1",
    "ink-text-input": "^5.0.1",
    "react": "^18.3.1",
    "react-devtools-core": "^7.0.1",
    "shiki": "^3.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "@types/diff": "^7.0.2",
    "@types/react": "^18.3.18",
    "typescript": "^5.7.3"
  }
}
